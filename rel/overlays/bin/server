#!/bin/bash
set -eu

cd -P -- "$(dirname -- "$0")"

if [ "$(id -u)" = "0" ]; then
  db_dir="$(dirname -- "${DATABASE_PATH:?DATABASE_PATH is not set}")"
  mkdir -p "$db_dir"
  chown -R nobody:nogroup "$db_dir"
  exec setpriv --reuid=nobody --regid=nogroup --init-groups "$0" "$@"
fi

./migrate

# Anubis (https://anubis.techaro.lol) takes the public port and forwards the
# requests it lets through to Phoenix on loopback. Both are configured through
# the environment, see fly.toml.
anubis &
anubis_pid=$!

PHX_SERVER=true ./luttmoov start &
phoenix_pid=$!

stop_all() {
  kill -TERM "$anubis_pid" "$phoenix_pid" 2>/dev/null || true
  wait
}

trap 'stop_all; exit 0' TERM INT

wait -n || true
echo "server: anubis or phoenix exited unexpectedly, shutting down" >&2
stop_all
exit 1
